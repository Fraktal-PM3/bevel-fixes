apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: firefly
  namespace: {{ component_ns }}
  annotations:
    fluxcd.io/automated: "false"
spec:
  interval: 1m
  releaseName: firefly
  chart:
    spec:
      interval: 1m
      sourceRef:
        kind: GitRepository
        name: flux-local
        namespace: flux-local
      chart: firefly-helm-charts/charts/firefly
  values:
    config:
      # Enable debug and admin APIs
      debugEnabled: true
      adminEnabled: true

      # Organization configuration
      organizationName: "{{ component }}"
      organizationKey: "{{ component }}"

      # Set Fabric as the default blockchain
      defaultBlockchainType: "fabric"

      # FabConnect configuration
      fabconnectUrl: ""  # Auto-discovered from subchart
      fabconnectChannel: "{{ fabric_channel }}"
      fabconnectChaincode: "{{ firefly_config.fabconnect_chaincode }}"
      # Use organization name as signer (matches official FireFly pattern)
      fabconnectSigner: "{{ component }}"
      fabconnectRetry: {{ firefly_config.fabconnect_retry | default(true) }}

      # Database configuration (auto-configured with built-in PostgreSQL)
      postgresAutomigrate: {{ firefly_config.postgres_automigrate | default(true) }}

      # Multiparty configuration
      multipartyEnabled: {{ firefly_config.multiparty_enabled | default(true) }}

    # Data exchange configuration for peer-to-peer communication
    dataexchange:
      enabled: {{ firefly_config.dataexchange_enabled | default(true) }}

      certificate:
        enabled: true
        issuerRef:
          kind: ClusterIssuer
          name: selfsigned-ca

      tlsSecret:
        enabled: false

    # FabConnect subchart configuration
    fabconnect:
      enabled: true

      image:
        tag: "latest"

      # FabConnect configuration
      config:
        # Enable automatic identity enrollment
        autoEnrollIdentity: "{{ component }}"

      # Fabric network connection details
      fabric:
        peerUrl: "{{ firefly_config.fabric_peer_url | default('grpcs://peer0.' + component + '-net.' + external_url_suffix + ':443') }}"
        ordererUrl: "{{ firefly_config.fabric_orderer_url | default('grpcs://orderer1.pm3org-net.' + external_url_suffix + ':443') }}"
        caUrl: "{{ firefly_config.fabric_ca_url | default('https://ca.' + component + '-net.' + external_url_suffix + ':443') }}"

        # Organization details
        organizationName: "{{ component }}-net"
        organizationMspId: "{{ component }}MSP"

        # Channel and chaincode
        channelName: "{{ fabric_channel }}"
        chaincodeName: "{{ firefly_config.fabconnect_chaincode }}"

        # CA enrollment credentials
        enrollId: "{{ component }}-admin"
        enrollSecret: "{{ component }}-adminpw"

      # MSP secret configuration
      msp:
        secretName: "fabconnect-msp"
        mountPath: "/etc/firefly/organizations"

      # Service configuration
      service:
        type: ClusterIP
        port: 3000

      # Resource allocation
      resources:
        limits:
          cpu: 500m
          memory: 512Mi
        requests:
          cpu: 100m
          memory: 128Mi

      # Persistent storage
      persistentVolume:
        accessModes:
          - ReadWriteOnce
        size: 5Gi
        storageClass: ""

      # Health check configuration
      healthcheck:
        enabled: true
        initialDelaySeconds: 15

      # Logging
      log:
        level: "info"

    # Core FireFly pod configuration
    core:
      enabled: true

      ingress:
        enabled: true
        className: "haproxy"
        annotations:
          external-dns.alpha.kubernetes.io/hostname: {{ firefly_hostname }}
          external-dns.alpha.kubernetes.io/target: {{ external_dns_target }}
        hosts:
          - host: {{ firefly_hostname }}
        tls: []

    # Sandbox UI
    sandbox:
      enabled: {{ firefly_config.sandbox_enabled | default(true) }}

      # Separate ingress for sandbox
      ingress:
        enabled: true
        className: "haproxy"
        annotations:
          external-dns.alpha.kubernetes.io/hostname: sandbox.{{ firefly_hostname }}
          external-dns.alpha.kubernetes.io/target: {{ external_dns_target }}
        hosts:
          - host: sandbox.{{ firefly_hostname }}
        tls: []

    # PostgreSQL
    postgres:
      enabled: true

    # IPFS
    ipfs:
      enabled: {{ firefly_config.ipfs_enabled | default(true) }}
